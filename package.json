{
  "name": "bonten",
  "version": "0.1.0",
  "private": true,
  "description": "BONTEN — Plataforma Gamer All-in-One",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @bonten/api prisma migrate dev",
    "db:generate": "pnpm --filter @bonten/api prisma generate"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "dependencies": {
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "socket.io": "^4.7.5"
  }
}