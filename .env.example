# =============================================================================
# BONTEN — variáveis de ambiente (EXEMPLO)
# Copie para .env e preencha. Nunca versione o arquivo .env.
# Nada com prefixo NEXT_PUBLIC_ pode conter segredo.
# =============================================================================

# ---------- Ambiente ----------
NODE_ENV=development

# ---------- PostgreSQL ----------
POSTGRES_USER=bonten
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=bonten
# DATABASE_URL montada a partir dos valores acima (usada pelo Prisma no host/container)
DATABASE_URL=postgresql://bonten:change_me_postgres@localhost:5432/bonten?schema=public

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis

# ---------- API (NestJS) ----------
API_PORT=4000
# Origem permitida do frontend (CORS) e URL pública do próprio backend
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Segredo de assinatura interna entre serviços (não é segredo público)
INTERNAL_SERVICE_SECRET=change_me_internal_secret
# Segredos de sessão/CSRF (só backend)
SESSION_SECRET=change_me_session_secret

# ---------- Frontend (Next.js) ----------
# Somente valores PÚBLICOS aqui. Nenhum segredo.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ---------- LiveKit (self-hosted, dev) ----------
# A chave SECRET fica SÓ no backend. O cliente recebe apenas token de curta duração.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey_change_me
LIVEKIT_API_SECRET=change_me_livekit_secret_at_least_32_chars_long
# URL pública que o cliente usa para conectar (pode ser pública)
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# ---------- GIF (provedores) ----------
# Chaves ficam SÓ no backend. Sem elas, /api/gifs responde gif_not_configured.
# Deixe ao menos uma preenchida (GIPHY tem prioridade sobre KLIPY).
GIPHY_API_KEY=
KLIPY_APP_KEY=

# ---------- SeaweedFS (S3 compatível, dev) ----------
# S3 compatível. Credenciais definidas em infra/seaweedfs/s3.json (dev).
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=bonten-media
S3_ACCESS_KEY=bonten
S3_SECRET_KEY=change_me_minio
S3_FORCE_PATH_STYLE=true
# URL pública do bucket/arquivos (pública, para servir mídia)
S3_PUBLIC_URL=http://localhost:8333/bonten-media
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:8333/bonten-media

# ---------- n8n (futuro, Fase 7) ----------
# N8N_BASIC_AUTH_USER=
# N8N_BASIC_AUTH_PASSWORD=
# N8N_WEBHOOK_SECRET=